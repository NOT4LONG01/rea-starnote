# dependencies and build output
node_modules/
dist/
target/

# the original StarNote app binary: proprietary and far over GitHub's 100 MB file limit
artifacts/
*.zip
*.apk

# secrets and local config: never commit
.env
.env.*
*.keystore
*.jks
local.properties

# generated by Tauri (the Android project under src-tauri/gen/android IS kept: it holds our manifest and Gradle setup)
src-tauri/gen/schemas/
src-tauri/gen/android/**/build/
src-tauri/gen/android/.gradle/
src-tauri/gen/android/**/src/main/jniLibs/
src-tauri/gen/android/**/src/main/assets/

# local test output and editor files
*.out
*.log
chrome-*/
.DS_Store
.idea/
.vscode/

# command-line bundle
dist-cli/
