{
  "name": "rea-starnote",
  "private": true,
  "version": "1.1.0-dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cli.json",
    "test": "node test/run-all.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "tauri": "tauri",
    "test:e2e": "node test/e2e/run-all.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "cli": "npm run build:cli --silent && node dist-cli/rea-starnote.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-http": "~2.8.2",
    "@tauri-apps/plugin-opener": "~2.7.1",
    "jszip": "^3.10.1",
    "mathjax-full": "3.2.2",
    "pdfjs-dist": "^5.4.530"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "22.20.5",
    "esbuild": "0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "description": "rea-starnote: viewer, editor and sync client for StarNote (.note) files (web, desktop, Android)",
  "engines": {
    "node": ">=20"
  }
}
